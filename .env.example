# Server listen port (both local Bun server and Compose host port mapping)
PORT=3020

# Web dev server listen port (used only by `bun run dev` / `bun run dev:web`)
WEB_PORT=3000

# Directory for SQLite database (app.db). In Docker, data persists at /data.
DATA_DIR=./data

# Built static web assets directory
WEB_DIR=./web/dist

# Set to 0 to disable new user registration (recommended after creating your account)
ALLOW_SIGNUP=1

# Set to 1 when serving behind HTTPS to mark session cookies Secure and send HSTS
COOKIE_SECURE=0

# Set to 1 when running behind a trusted reverse proxy so X-Forwarded-For is honoured for rate limiting
TRUST_PROXY=0

# Set to js to force the TypeScript CP037 decoder instead of the optional Rust N-API addon
EXPENSE_CP037_MODE=js

# Container image tag used by compose.yaml (e.g. latest, 0.1.0, 0.1)
IMAGE_TAG=latest
