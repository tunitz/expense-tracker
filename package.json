{
  "name": "expense-tracker",
  "version": "0.1.0",
  "module": "src/server/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build:native && bun scripts/dev.ts",
    "dev:web": "bun web/dev.ts",
    "build:native": "bun scripts/build-native.ts",
    "build": "tsc -p web/tsconfig.json --noEmit && bun web/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json web/src",
    "start": "bun run build:native && bun src/server/main.ts"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.51.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7"
  }
}
